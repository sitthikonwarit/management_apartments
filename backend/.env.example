SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
DRIVE_FOLDER_ID=your_google_drive_folder_id_here
# ใช้เซ็น/ตรวจสอบ JWT token ตอน login — เปลี่ยนเป็นค่าสุ่มยาวๆ ของตัวเอง (อย่าใช้ค่านี้จริง) ห้ามรั่วไหล
JWT_SECRET=change-this-to-a-long-random-secret-string
# URL สาธารณะ (https://) ที่เข้าถึง backend นี้ได้จากนอกวง LAN — ใช้แปลง path รูปสลิปการโอนที่อัปโหลดไว้
# (/uploads/payments/...) ให้เป็น URL เต็มสำหรับปุ่ม "ดูสลิปการโอน" ในใบเสร็จ LINE ถ้าไม่ตั้งค่าไว้จะไม่แสดงปุ่มนี้
PUBLIC_BASE_URL=https://your-public-domain.example.com
# ── หน้าควบคุมแพลตฟอร์ม (routes/superadmin.ts) — ดูรายชื่อองค์กรลูกค้าทั้งหมด/ระงับ/ลบองค์กร ──
# LINE User ID ของคุณเอง (คนเดียวเท่านั้นที่เข้าหน้านี้ได้) หาได้จากการล็อกอินปกติครั้งหนึ่งแล้วดูค่า
# lineUserId ของบัญชีตัวเองในตาราง users หรือดูจาก log ตอนล็อกอิน — ไม่ตั้งค่านี้ = ปิดหน้าควบคุมนี้ทั้งหมด
# (ทุก request ไปหน้านี้จะถูกปฏิเสธ แม้จะมี token ที่ signed ถูกต้องอยู่ก็ตาม)
SUPERADMIN_LINE_USER_ID=
# ใช้ LINE Login channel เดียวกับที่ตั้งค่าไว้แล้ว (LINE_LOGIN_CHANNEL_ID/SECRET ด้านบน) แต่ต้องเพิ่ม
# Callback URL ที่สองใน LINE Developers Console ของ channel นั้น: {PUBLIC_BASE_URL}/auth/superadmin/callback
# (นอกเหนือจาก {PUBLIC_BASE_URL}/auth/line/callback ที่มีอยู่แล้วสำหรับลูกค้าทั่วไป)
# ทางลัด: ล็อกอินด้วยรหัสผ่านเดียวแทน LINE Login ก็ได้ (เร็วกว่า ไม่ต้องผ่าน LINE) — เปลี่ยนเป็นรหัสผ่านสุ่ม
# ยาวๆ ของตัวเอง ไม่ตั้งค่านี้ไว้ = ปิดช่องทางรหัสผ่าน เหลือแค่ล็อกอินผ่าน LINE เท่านั้น
SUPERADMIN_PASSWORD=
# ── เข้ารหัสข้อมูลอ่อนไหวในฐานข้อมูล (lib/encryption.ts) — เลขบัตร ปชช./ที่อยู่ผู้เช่า, LINE channel
# token/secret, EasySlip API key ของทุกองค์กร + เซ็นลายเซ็น URL ไฟล์อัปโหลด (/uploads/*) กันเดา/ไล่สแกน ──
# สร้างด้วย `openssl rand -base64 32` เปลี่ยนเป็นค่าสุ่มยาวๆ ของตัวเอง (อย่าใช้ค่านี้จริง) ห้ามรั่วไหล — ถ้า
# เปลี่ยนค่านี้ทีหลัง ข้อมูลที่เข้ารหัสไว้แล้วในฐานข้อมูลจะถอดรหัสไม่ได้อีก และลิงก์ไฟล์อัปโหลดที่เคยส่งออกไป
# (เช่น ลิงก์ดูสลิปในแชท LINE เก่า) จะใช้ไม่ได้ทั้งหมดทันที (เหมือนเปลี่ยน JWT_SECRET แล้ว session เดิมหลุดหมด)
FIELD_ENCRYPTION_KEY=change-this-to-a-long-random-secret-string
